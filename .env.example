# OpenRouter API key — ALL AI (vision analysis, chatbot, shop checks) routes
# through OpenRouter. It is the single provider layer; there are deliberately
# no direct Gemini / Anthropic / OpenAI SDK paths in this codebase.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Models — one per task. Defaults shown.
#
# The free Nemotron models this app used previously were withdrawn from
# OpenRouter (both now return HTTP 404), which is why these defaults are paid.
# Any vision-capable model with strict json_schema support will work.
# ---------------------------------------------------------------------------

# Vision model that classifies a face into a season (~$0.0035 per analysis).
# MODEL_CLASSIFY=google/gemini-3.8-flash

# Model backing the stylist chatbot.
# MODEL_CHAT=google/gemini-3.8-flash

# Vision model for "Before You Buy" product checks.
# MODEL_SHOP=google/gemini-3.8-flash

# Optional. Tried automatically when the primary model call FAILS — a withdrawn
# model ID, a provider outage, a persistent 429.
# OPENROUTER_FALLBACK_MODEL=

# DEPRECATED — superseded by MODEL_CLASSIFY / MODEL_CHAT. Still honored (with a
# warning) so an existing deployment does not silently fall back to a dead model.
# OPENROUTER_MODEL=
# OPENROUTER_CHAT_MODEL=

# ---------------------------------------------------------------------------
# Analysis pipeline
# ---------------------------------------------------------------------------

# hybrid (default) = the browser measures colour and the server ranks the
# seasons from it; the model gets the measured values plus the rules' top three
# seasons (alphabetical, unscored) and must choose among them. An answer outside
# the three is overruled by the rules' primary. A request without measured
# features degrades to llm_only automatically.
# ANALYSIS_MODE=hybrid

# Reasoning tokens are a large share of classification cost but appear to help
# on a judgement-heavy task. Default true; the eval harness varies this.
# CLASSIFY_REASONING=true

# How long to wait for OpenRouter before giving up, in ms. Default 120000.
# A backstop against a connection that is accepted and then never answered,
# not a latency budget — a real classification takes 15-25s.
# OPENROUTER_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=3001

# Upload size limit (e.g. 10mb, 500kb, or raw bytes)
MAX_FILE_SIZE=10mb

# Extra origins the LOCAL dev server accepts. Not needed in production: the
# API is same-origin under /api, so there is no CORS to configure.
# CORS_ORIGINS=http://localhost:5180

# Do NOT set VITE_API_BASE in production. It defaults to "/api", which is
# same-origin on Vercel. Setting it re-introduces cross-origin requests.

# ---------------------------------------------------------------------------
# Daily limits (production) — 15 chat messages, 5 analyses, 10 shop checks per
# visitor per UTC day, counted in Upstash Redis. Leave all of these unset for
# local development: unconfigured means unlimited.
#
# 1. upstash.com → Create database (Redis, free tier, any region near your
#    Vercel region) → REST API section → copy the URL and the token.
# 2. RATE_LIMIT_SALT: `openssl rand -hex 32`. The visitor key is
#    sha256(salt + ip) — the raw IP is never stored. Without a salt the limiter
#    refuses to run. Changing the salt resets everyone's count.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_SALT=

# Optional. Requests carrying this value in the `x-aura-bypass` header are not
# counted. Set the same value as the RATE_LIMIT_BYPASS_TOKEN secret in GitHub
# Actions so the weekly e2e does not use up the daily allowance.
# RATE_LIMIT_BYPASS_TOKEN=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# /api/health reports "degraded" when the OpenRouter balance is below this (USD).
# OPENROUTER_BALANCE_ALERT_USD=5
