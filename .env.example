# OpenRouter API key — all AI (vision analysis, chatbot, shop checks) routes
# through OpenRouter. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Model served via OpenRouter (vision-capable). Default shown.
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Optional second model tried automatically if the primary fails.
# OPENROUTER_FALLBACK_MODEL=

# Fast text model used for the chatbot (vision not needed there). Default shown.
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Second-opinion season validation call (default on; set false to save a round trip)
# ENABLE_CROSS_VALIDATION=true

# Server port
PORT=3001

# Upload size limit (e.g. 10mb, 500kb, or raw bytes)
MAX_FILE_SIZE=10mb

# How long analysis sessions live in memory (hours, default 24)
# SESSION_TTL_HOURS=24

# Comma-separated extra allowed CORS origins (the deployed frontend URL)
# CORS_ORIGINS=https://your-frontend.vercel.app
